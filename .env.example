ENVIRONMENT=development

# Model provider: anthropic | gemini | openai | auto (falls back to offline replay with no key)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Signed-in employee (until a full auth module lands)
EMPLOYEE_NAME=Chandra Sharma
EMPLOYEE_DEPT=Engineering

# Home currency for claim totals (FX rates configurable via /api/admin/config)
HOME_CURRENCY=INR

# Admin access for Settings/policy changes (sent as X-Admin-Token header).
# Leave unset for open access in development.
# ADMIN_TOKEN=choose-a-strong-secret

# Set to 0 to skip seeding the offline demo claim
SEED_DEMO=1
